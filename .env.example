# Copy to .env.local (git-ignored) for local development; set the same names in Vercel for the deployed site.
# These are baked into the browser bundle, so anything here is readable by every visitor.
# Use a HiveMQ credential that can ONLY subscribe to the telemetry topics (read-only ACL).
NEXT_PUBLIC_MQTT_URL=wss://q2d87a43.ala.asia-southeast1.emqxsl.com:8084/mqtt
NEXT_PUBLIC_MQTT_USER=
NEXT_PUBLIC_MQTT_PASS=

# Server/Pi side (publishers) - separate credential with publish rights, never NEXT_PUBLIC_
MQTT_PASS=
HIVEMQ_PASS=
